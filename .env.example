# ─── Banco de Dados ───────────────────────────────────────────────────────────
DATABASE_URL=""
DIRECT_URL=""

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=""

# ─── Storage ──────────────────────────────────────────────────────────────────
# STORAGE_PROVIDER=local | vercel-blob
STORAGE_PROVIDER=""
UPLOAD_MAX_SIZE_MB=""
# Apenas se STORAGE_PROVIDER=vercel-blob:
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ─── IA / LLM (Groq e Assistente Flutuante) ──────────────────────────────────
# Necessário para: análise de paciente, sugestão de planos, resumo de anamnese
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=""

# Configuração do Assistente Flutuante (Floating AI)
# AI_PROVIDER pode ser: ollama | openrouter | groq | disabled
AI_PROVIDER=""
OLLAMA_BASE_URL=""
OLLAMA_MODEL=""
AI_API_KEY=""
AI_MODEL=""
AI_ASSISTANT_ENABLED=""

# ─── E-mail (Resend) ──────────────────────────────────────────────────────────
# Necessário para: convites de equipe, notificações
# Obter em: https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ─── WhatsApp (Evolution API) ─────────────────────────────────────────────────
# Necessário para: lembretes automáticos via WhatsApp
# Documentação: https://doc.evolution-api.com
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME=""

# ─── Cron (Vercel / externo) ──────────────────────────────────────────────────
# Secret para proteger o endpoint /api/cron/process-reminders
CRON_SECRET=""

# ─── Google Calendar (OAuth2) ─────────────────────────────────────────────────
# Necessário para: sincronização de consultas com Google Agenda
# Criar credenciais em: https://console.cloud.google.com/apis/credentials
# Redirect URI autorizado: https://seuapp.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=""

# ─── WebRTC (Atendimento Online Nativo) ───────────────────────────────────────
# STUN público (padrão Google, sem configuração necessária)
NEXT_PUBLIC_WEBRTC_STUN_URL=""
# TURN (necessário para produção em redes restritas)
WEBRTC_TURN_URL=""
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""

# ─── Google Meet (Integração API) ─────────────────────────────────────────────
GOOGLE_MEET_ENABLED=""
# (GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET já declarados acima em Google Calendar)
GOOGLE_MEET_SCOPES=""

# ─── Transcrição de Atendimentos ─────────────────────────────────────────────
# TRANSCRIPTION_PROVIDER pode ser: MANUAL | LOCAL_WHISPER | CUSTOM_HTTP | OPENAI_WHISPER_API | ELEVENLABS | DISABLED
TRANSCRIPTION_ENABLED=""
TRANSCRIPTION_PROVIDER=""

TRANSCRIPTION_MAX_AUDIO_SIZE_MB=""
TRANSCRIPTION_ALLOWED_TYPES=""

TRANSCRIPTION_STORAGE_PROVIDER=""
TRANSCRIPTION_STORAGE_PATH=""

# Provider LOCAL_WHISPER (requer binário local ou via Docker)
LOCAL_WHISPER_ENABLED=""
LOCAL_WHISPER_BINARY_PATH=""
LOCAL_WHISPER_MODEL_PATH=""
LOCAL_WHISPER_MODEL=""

# Provider CUSTOM_HTTP (microserviço Python/FastAPI com Whisper)
# Endpoint esperado: POST /transcribe com form-data ou JSON
CUSTOM_TRANSCRIPTION_HTTP_URL=""
CUSTOM_TRANSCRIPTION_HTTP_TOKEN=""

# Providers pagos (opcionais, desativados por padrão)
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""

# Provider realtime self-hosted (Speaches + gateway dedicado)
TRANSCRIPTION_REALTIME_PROVIDER=""
TRANSCRIPTION_PUBLIC_WS_URL=""
TRANSCRIPTION_WS_URL=""
TRANSCRIPTION_HTTP_URL=""
TRANSCRIPTION_API_KEY=""
# Mesmo secret configurado no gateway. Use no mínimo 32 bytes aleatórios.
TRANSCRIPTION_TOKEN_SECRET=""
TRANSCRIPTION_TOKEN_ISSUER=""
TRANSCRIPTION_TOKEN_AUDIENCE=""
TRANSCRIPTION_DEFAULT_MODEL=""
TRANSCRIPTION_FALLBACK_MODEL=""
TRANSCRIPTION_LANGUAGE=""
TRANSCRIPTION_SAMPLE_RATE=""
TRANSCRIPTION_CHUNK_MS=""
TRANSCRIPTION_SAVE_AUDIO=""
TRANSCRIPTION_MAX_RECONNECT_ATTEMPTS=""
TRANSCRIPTION_PROVIDER_HEALTHCHECK_INTERVAL_SECONDS=""

# ── Native call signaling (polling default / websocket recommended) ─────────
# polling (default, no setup) | websocket (needs scripts/signaling-server.ts) | sse (avoid on `next dev`)
NEXT_PUBLIC_SIGNALING_TRANSPORT=""
# Only for websocket transport — run the dedicated server: npm run signaling
# NEXT_PUBLIC_SIGNALING_WS_URL=ws://localhost:3001
# SIGNALING_SERVER_PORT=3001
# Extra allowed Origins for the WS server, comma-separated (apex + www differ).
# In production point NEXT_PUBLIC_SIGNALING_WS_URL to a wss:// host running
# scripts/signaling-server.ts on Railway/Render/Fly (Vercel can't run it) —
# see docs/CARE_SESSION_SIGNALING_PRODUCTION_DEPLOY.md
# SIGNALING_ALLOWED_ORIGINS=https://nutriopus.com,https://www.nutriopus.com

# ── WebRTC ICE ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# TURN is REQUIRED for production (restricted networks). Use short-lived creds.
# NEXT_PUBLIC_WEBRTC_TURN_URL=
# NEXT_PUBLIC_WEBRTC_TURN_USERNAME=
# NEXT_PUBLIC_WEBRTC_TURN_CREDENTIAL=

# ── Cron jobs (Vercel) ────────────────────────────────────────────────────────
# Secures /api/cron/* routes — Vercel sends this as `Authorization: Bearer <value>`
# automatically when it invokes a scheduled cron job (see vercel.json "crons").
# Generate a random string of at least 16 characters. Required in production;
# without it, /api/cron/* routes reject every request (fail closed).
# CRON_SECRET=
