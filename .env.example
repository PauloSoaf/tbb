# TBB only. Generate independent development secrets with npm run setup:local.
DATABASE_URL="postgresql://tbb:CHANGE_ME@localhost:5440/tbb?schema=public"
DIRECT_URL="postgresql://tbb:CHANGE_ME@localhost:5440/tbb?schema=public"
TBB_DB_PASSWORD="CHANGE_ME"
JWT_SECRET="GENERATE_AT_LEAST_32_RANDOM_BYTES"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""
OPENAI_API_KEY=""
OPENAI_FINANCE_MODEL="gpt-5.5"
OPENAI_ASSISTANT_MODEL="gpt-5.5"
# Optional. Without a key, Investments uses CoinGecko's public demo limits and keeps a local stale-safe cache.
COINGECKO_API_KEY=""

# Open Finance through Meu Pluggy (free, personal use only). Create an application at https://dashboard.pluggy.ai and copy
# the Client ID; the Client Secret is shown once. Keep both on the server only, never in NEXT_PUBLIC_ variables or in git.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Optional. Protects the stored connection ids. Falls back to JWT_SECRET; at least 32 characters.
OPEN_FINANCE_DATA_KEY=
# Required for the scheduled sync (/api/open-finance/cron), at least 24 characters. Vercel Cron also reads CRON_SECRET.
OPEN_FINANCE_CRON_SECRET=
