// Generated by npm run prisma:assemble from the reviewed domain fragments.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PartnerConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  BLOCKED
}

model User {
  id                     String              @id @default(cuid())
  name                   String
  email                  String              @unique
  passwordHash           String
  isGlobalAdmin          Boolean             @default(false)
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  memberships            Membership[]
  sessions               UserSession[]
  notifications          Notification[]
  activityEvents         ActivityEvent[]
  partnerInvitesCreated  PartnerConnection[] @relation("PartnerConnectionRequestedBy")
  partnerInvitesAccepted PartnerConnection[] @relation("PartnerConnectionAcceptedBy")
}

model Workspace {
  habits                        Habit[]
  habitSchedules                HabitSchedule[]
  habitEntries                  HabitEntry[]
  tasks                         Task[]
  projects                      Project[]
  goals                         Goal[]
  accounts                      Account[]
  financeCategories             FinanceCategory[]
  financeTransactions           FinanceTransaction[]
  budgets                       Budget[]
  subscriptions                 Subscription[]
  debts                         Debt[]
  personalAssets                PersonalAsset[]
  savingsGoals                  SavingsGoal[]
  importBatches                 ImportBatch[]
  importMappings                ImportMapping[]
  transactionRules              TransactionRule[]
  cardStatements                CardStatement[]
  financePlan                   FinancePlan?
  fixedExpenses                 FixedExpense[]
  investmentAccounts            InvestmentAccount[]
  investmentAssets              InvestmentAsset[]
  investmentPositions           InvestmentPosition[]
  investmentTransactions        InvestmentTransaction[]
  investmentIncome              InvestmentIncome[]
  investmentBudgets             InvestmentBudget[]
  investmentAllocationTargets   InvestmentAllocationTarget[]
  investmentPortfolioSnapshots  InvestmentPortfolioSnapshot[]
  investmentBenchmarks          InvestmentBenchmark[]
  investmentWatchlists          InvestmentWatchlist[]
  investmentResearchNotes       InvestmentResearchNote[]
  investmentGoalLinks           InvestmentGoalLink[]
  investmentTrades              InvestmentTrade[]
  investmentPriceAlerts         InvestmentPriceAlert[]
  investmentMonthlyReviews      InvestmentMonthlyReview[]
  companies                     Company[]
  applications                  Application[]
  contacts                      Contact[]
  interviews                    Interview[]
  offers                        Offer[]
  careerDocuments               CareerDocument[]
  id                            String                        @id @default(cuid())
  name                          String
  slug                          String                        @unique
  timezone                      String                        @default("America/Manaus")
  locale                        String                        @default("pt-BR")
  currency                      String                        @default("BRL")
  isActive                      Boolean                       @default(true)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  memberships                   Membership[]
  sessions                      UserSession[]
  activityEvents                ActivityEvent[]
  notifications                 Notification[]
  subscription                  WorkspaceSubscription?
  featureOverrides              WorkspaceFeatureOverride[]
  usageCounters                 UsageCounter[]
  storageFiles                  StorageFile[]
  rolePermissions               RolePermission[]
  partnerConnectionsAsRequester PartnerConnection[]           @relation("PartnerConnectionRequester")
  partnerConnectionsAsReceiver  PartnerConnection[]           @relation("PartnerConnectionReceiver")
  partnerSharingPolicies        PartnerSharingPolicy[]
  financialSources              FinancialSource[]
  statementPayments             CardStatementPayment[]
  financialSnapshots            FinancialSnapshot[]
}

model Membership {
  id                  String                     @id @default(cuid())
  workspaceId         String
  userId              String
  role                MembershipRole             @default(MEMBER)
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionOverrides MemberPermissionOverride[]

  @@unique([workspaceId, userId])
  @@index([userId, isActive])
}

model UserSession {
  id               String        @id @default(cuid())
  userId           String
  workspaceId      String
  sessionTokenHash String        @unique
  status           SessionStatus @default(ACTIVE)
  userAgent        String?
  expiresAt        DateTime
  lastSeenAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  revokedAt        DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([workspaceId, status])
}

model ActivityEvent {
  id          String    @id @default(cuid())
  workspaceId String
  type        String
  entityType  String
  entityId    String
  actorUserId String?
  metadata    Json      @default("{}")
  source      String    @default("MANUAL")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  body        String
  href        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}

model Permission {
  id              String                     @id @default(cuid())
  key             String                     @unique
  description     String
  rolePermissions RolePermission[]
  overrides       MemberPermissionOverride[]
}

model RolePermission {
  id           String         @id @default(cuid())
  workspaceId  String
  role         MembershipRole
  permissionId String
  enabled      Boolean        @default(true)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role, permissionId])
}

model MemberPermissionOverride {
  id           String           @id @default(cuid())
  membershipId String
  permissionId String
  effect       PermissionEffect
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permissionId])
}

model PartnerConnection {
  id                   String                  @id @default(cuid())
  requesterWorkspaceId String
  receiverWorkspaceId  String?
  requestedByUserId    String
  acceptedByUserId     String?
  status               PartnerConnectionStatus @default(PENDING)
  inviteTokenHash      String?                 @unique
  inviteExpiresAt      DateTime?
  createdAt            DateTime                @default(now())
  acceptedAt           DateTime?
  revokedAt            DateTime?
  requesterWorkspace   Workspace               @relation("PartnerConnectionRequester", fields: [requesterWorkspaceId], references: [id], onDelete: Cascade)
  receiverWorkspace    Workspace?              @relation("PartnerConnectionReceiver", fields: [receiverWorkspaceId], references: [id], onDelete: Cascade)
  requestedByUser      User                    @relation("PartnerConnectionRequestedBy", fields: [requestedByUserId], references: [id])
  acceptedByUser       User?                   @relation("PartnerConnectionAcceptedBy", fields: [acceptedByUserId], references: [id])
  sharingPolicies      PartnerSharingPolicy[]

  @@index([requesterWorkspaceId, status])
  @@index([receiverWorkspaceId, status])
}

model PartnerSharingPolicy {
  id               String            @id @default(cuid())
  connectionId     String
  ownerWorkspaceId String
  module           String
  enabled          Boolean           @default(true)
  updatedAt        DateTime          @updatedAt
  connection       PartnerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  ownerWorkspace   Workspace         @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Cascade)

  @@unique([connectionId, ownerWorkspaceId, module])
}

model SubscriptionPlan {
  id            String                  @id @default(cuid())
  code          String                  @unique
  name          String
  description   String?
  priceCents    Int?
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  featureLimits FeatureLimit[]
  subscriptions WorkspaceSubscription[]
}

model FeatureLimit {
  id      String           @id @default(cuid())
  planId  String
  key     String
  enabled Boolean          @default(true)
  limit   Int?
  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model WorkspaceSubscription {
  id          String           @id @default(cuid())
  workspaceId String           @unique
  planId      String
  status      BillingStatus    @default(TRIAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
}

model WorkspaceFeatureOverride {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  enabled     Boolean   @default(true)
  limit       Int?
  expiresAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model UsageCounter {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  periodStart DateTime
  count       Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, periodStart])
}

model StorageFile {
  id               String    @id @default(cuid())
  workspaceId      String
  storageKey       String    @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  purpose          String
  uploadedByUserId String
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, purpose])
}

model AuthAttempt {
  key         String   @id
  attempts    Int      @default(1)
  windowStart DateTime @default(now())
}

enum HabitType {
  BOOLEAN
  QUANTITY
  DURATION
  PAGES
  DISTANCE
  MONEY
  CUSTOM
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Habit {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  icon        String         @default("◉")
  color       String         @default("#10b981")
  type        HabitType      @default(BOOLEAN)
  target      Float          @default(1)
  unit        String         @default("vezes")
  frequency   HabitFrequency @default(DAILY)
  startDate   String
  endDate     String?
  isArchived  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  schedule    HabitSchedule?
  entries     HabitEntry[]

  @@index([workspaceId, isArchived])
}

model HabitSchedule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  habitId     String    @unique
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  days        Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  time        String?
  monthlyDay  Int?

  @@index([workspaceId])
}

model HabitEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date        String
  value       Float     @default(0)
  completed   Boolean   @default(false)
  note        String?
  source      String    @default("MANUAL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([habitId, date])
  @@index([workspaceId, date])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ARCHIVED
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String        @default("#6366f1")
  icon        String        @default("◈")
  status      ProjectStatus @default(ACTIVE)
  startDate   String?
  targetDate  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks       Task[]

  @@index([workspaceId, status])
}

model Task {
  id                String       @id @default(cuid())
  workspaceId       String
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TODO)
  dueDate           String?
  scheduledAt       DateTime?
  estimatedDuration Int?
  tags              String[]     @default([])
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([workspaceId, status, dueDate])
  @@index([projectId])
}

model Goal {
  id             String     @id @default(cuid())
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           String     @default("NUMERIC")
  target         Float
  current        Float      @default(0)
  unit           String     @default("unidades")
  targetDate     String?
  status         GoalStatus @default(ACTIVE)
  linkedModule   String?
  linkedEntityId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([workspaceId, status])
}

// Finance fragment; merged into the baseline by the root agent.
enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
  DIGITAL_WALLET
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  ADJUSTMENT
}

model Account {
  id                           String                  @id @default(cuid())
  workspaceId                  String
  name                         String
  type                         AccountType             @default(CHECKING)
  institution                  String?
  currency                     String                  @default("BRL")
  initialBalanceCents          Int                     @default(0)
  creditLimitCents             Int?
  closingDay                   Int?
  dueDay                       Int?
  isArchived                   Boolean                 @default(false)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  workspace                    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions                 FinanceTransaction[]    @relation("OriginAccount")
  incomingTransactions         FinanceTransaction[]    @relation("DestinationAccount")
  subscriptions                Subscription[]
  savingsGoals                 SavingsGoal[]
  importBatches                ImportBatch[]
  investmentAccounts           InvestmentAccount[]     @relation("LinkedFinanceAccount")
  fundedInvestmentTransactions InvestmentTransaction[] @relation("InvestmentFundingAccount")
  cardStatements               CardStatement[]
  incomePlans                  FinancePlan[]
  financialSources             FinancialSource[]
  statementPayments            CardStatementPayment[]
  financialSnapshots           FinancialSnapshot[]

  @@unique([id, workspaceId])
  @@index([workspaceId, isArchived])
}

// Planning never posts income or expenses to the account ledger.
model FinancePlan {
  workspaceId String @id
  incomeCents Int @default(0)
  payDay Int?
  receivingAccountId String?
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  receivingAccount Account? @relation(fields: [receivingAccountId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  @@index([receivingAccountId, workspaceId])
}

model FixedExpense {
  id String @id @default(cuid())
  workspaceId String
  name String
  amountCents Int
  dueDay Int?
  notes String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, isActive])
}

enum CardStatementKind {
  STATEMENT
  MONTHLY_PROJECTION
}

enum CardStatementStatus {
  PAID
  OPEN
  FUTURE_KNOWN
  FORECAST
}

enum CardStatementReconciliation {
  NOT_REQUIRED
  PENDING
  INCLUDED_IN_STATEMENT
  SEPARATE_CHARGE
}

// Aggregated card statement or monthly projection. It lives beside the ledger and
// never creates FinanceTransaction rows, so card purchases are not counted twice.
// Null dates mean "not provided by the source", never inferred.
model CardStatement {
  id                  String                      @id @default(cuid())
  workspaceId         String
  accountId           String
  kind                CardStatementKind
  status              CardStatementStatus
  periodKey           String
  externalKey         String
  amountCents         Int
  currency            String                      @default("BRL")
  dueDate             DateTime?                   @db.Date
  closingDate         DateTime?                   @db.Date
  closingDay          Int?
  referenceMonth      String?
  paidAt              DateTime?                   @db.Date
  reconciliation      CardStatementReconciliation @default(NOT_REQUIRED)
  overlapsStatementId String?
  sourceRecordType    String
  sourceAsOf          DateTime                    @db.Date
  source              String                      @default("MANUAL_IMPORT")
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  workspace           Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account             Account                     @relation(fields: [accountId, workspaceId], references: [id, workspaceId])
  overlapsStatement   CardStatement?              @relation("CardStatementOverlap", fields: [overlapsStatementId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  overlappedBy        CardStatement[]             @relation("CardStatementOverlap")
  transactions        FinanceTransaction[]
  payments            CardStatementPayment[]
  rolledIntoStatementId String?
  rolledIntoStatement CardStatement? @relation("StatementRollover", fields: [rolledIntoStatementId, accountId, workspaceId], references: [id, accountId, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  rolledFrom          CardStatement[] @relation("StatementRollover")
  amountIsOutstanding Boolean @default(false)

  @@unique([id, workspaceId])
  @@unique([id, accountId, workspaceId])
  @@unique([workspaceId, externalKey])
  @@unique([workspaceId, accountId, periodKey])
  @@index([workspaceId, status, dueDate])
  @@index([rolledIntoStatementId, accountId, workspaceId])
}

model FinanceCategory {
  id            String               @id @default(cuid())
  workspaceId   String
  name          String
  type          String               @default("EXPENSE")
  icon          String               @default("tag")
  color         String               @default("#8b8ef5")
  parentId      String?
  isSystem      Boolean              @default(false)
  isArchived    Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent        FinanceCategory?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      FinanceCategory[]    @relation("CategoryTree")
  transactions  FinanceTransaction[]
  budgets       Budget[]
  subscriptions Subscription[]
  rules         TransactionRule[]

  @@unique([workspaceId, name])
}

model FinanceTransaction {
  id                     String                  @id @default(cuid())
  workspaceId            String
  accountId              String
  destinationAccountId   String?
  categoryId             String?
  type                   TransactionType
  description            String
  merchant               String?
  amountCents            Int
  currency               String                  @default("BRL")
  date                   DateTime                @db.Date
  competenceDate         DateTime?               @db.Date
  installmentNumber      Int?
  installmentTotal       Int?
  recurring              Boolean                 @default(false)
  recurringGroupId       String?
  tags                   String[]                @default([])
  notes                  String?
  source                 String                  @default("MANUAL")
  externalId             String?
  fingerprint            String?
  importBatchId          String?
  cardStatementId        String?
  statementDetailMode    StatementDetailMode?
  revision               Int                     @default(0)
  purchasedDate          DateTime?               @db.Date
  postedDate             DateTime?               @db.Date
  occurredAt             DateTime?
  occurredTimezone       String?
  dateBasis              String                  @default("MANUAL")
  eventKind              String                  @default("PURCHASE")
  isConsumption          Boolean                 @default(true)
  originalAmountCents    Int?
  originalCurrency       String?
  exchangeRate           String?
  subscriptionId         String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                Account                 @relation("OriginAccount", fields: [accountId], references: [id])
  // Same workspace and same card as the statement, enforced by the composite key.
  cardStatement          CardStatement?          @relation(fields: [cardStatementId, accountId, workspaceId], references: [id, accountId, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  destinationAccount     Account?                @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  category               FinanceCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch            ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  investmentTransactions InvestmentTransaction[] @relation("InvestmentFinanceTransaction")
  investmentIncomeLinks  InvestmentIncome[]      @relation("InvestmentIncomeFinanceTransaction")
  evidence               FinancialEvidence[]
  subscription           Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, date])
  @@index([workspaceId, accountId, date])
  @@index([workspaceId, importBatchId])
  @@index([workspaceId, cardStatementId])
  @@index([subscriptionId])
}

// How a card purchase relates to the statement it is detailed under: already part of the
// declared amount, or added on top of it. Either way it is never counted twice.
enum StatementDetailMode {
  ALREADY_INCLUDED
  ADDED_TO_STATEMENT
}

model Budget {
  id          String          @id @default(cuid())
  workspaceId String
  categoryId  String
  period      String          @default("MONTHLY")
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  limitCents  Int
  currency    String          @default("BRL")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    FinanceCategory @relation(fields: [categoryId], references: [id])

  @@unique([workspaceId, categoryId, startDate, endDate])
}

model Subscription {
  id             String           @id @default(cuid())
  workspaceId    String
  name           String
  merchant       String?
  amountCents    Int
  currency       String           @default("BRL")
  billingCycle   String           @default("MONTHLY")
  customDays     Int?
  nextChargeDate DateTime         @db.Date
  accountId      String?
  categoryId     String?
  startedAt      DateTime         @db.Date
  status         String           @default("ACTIVE")
  nextChargeIsEstimate Boolean @default(false)
  amountIsEstimate Boolean @default(false)
  originalAmountCents Int?
  originalCurrency String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account        Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category       FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions   FinanceTransaction[]

  @@index([workspaceId, status, nextChargeDate])
}

model Debt {
  id                    String    @id @default(cuid())
  workspaceId           String
  name                  String
  originalAmountCents   Int
  remainingBalanceCents Int
  currency              String    @default("BRL")
  interestBasisPoints   Int       @default(0)
  ratePeriod            String    @default("MONTHLY")
  minimumPaymentCents   Int
  installments          Int?
  dueDay                Int?
  startDate             DateTime  @db.Date
  targetPayoffDate      DateTime? @db.Date
  status                String    @default("ACTIVE")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personalAssets        PersonalAsset[]

  @@index([workspaceId, status])
}

enum PersonalAssetKind {
  VEHICLE
  ELECTRONIC
  PROPERTY
  OTHER
}

model PersonalAsset {
  id                 String            @id @default(cuid())
  workspaceId        String
  name               String
  kind               PersonalAssetKind
  valueCents         Int
  valuationDate      DateTime          @db.Date
  purchaseValueCents Int?
  purchaseDate       DateTime?         @db.Date
  notes              String?
  debtId             String?
  archivedAt         DateTime?
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  debt               Debt?             @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([workspaceId, archivedAt])
  @@index([debtId])
}

model SavingsGoal {
  id                 String               @id @default(cuid())
  workspaceId        String
  name               String
  targetAmountCents  Int
  currentAmountCents Int                  @default(0)
  currency           String               @default("BRL")
  targetDate         DateTime?            @db.Date
  linkedAccountId    String?
  status             String               @default("ACTIVE")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedAccount      Account?             @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  investmentLinks    InvestmentGoalLink[]

  @@index([workspaceId, status])
}

model ImportBatch {
  id              String               @id @default(cuid())
  workspaceId     String
  accountId       String
  status          String               @default("UPLOADED")
  source          String               @default("CSV")
  fileName        String
  fileSize        Int
  rawContent      String?
  mapping         Json?
  preview         Json?
  rowCount        Int                  @default(0)
  importedCount   Int                  @default(0)
  duplicateCount  Int                  @default(0)
  failedCount     Int                  @default(0)
  rolledBackCount Int                  @default(0)
  preservedCount  Int                  @default(0)
  createdAt       DateTime             @default(now())
  completedAt     DateTime?
  rolledBackAt    DateTime?
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         Account              @relation(fields: [accountId], references: [id])
  transactions    FinanceTransaction[]

  @@index([workspaceId, createdAt])
}

model ImportMapping {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  source      String    @default("CSV")
  mapping     Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// Originals and candidate evidence are private to the workspace owner. Source identities
// use content hash + account; row identities never masquerade as an issuer external ID.
model FinancialSource {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  sha256 String
  fileName String
  mediaType String
  content Bytes
  byteLength Int
  importBatchId String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  evidence FinancialEvidence[]
  snapshots FinancialSnapshot[]
  @@unique([id, workspaceId])
  @@unique([workspaceId, accountId, sha256])
  @@index([importBatchId])
}

model FinancialEvidence {
  id String @id @default(cuid())
  workspaceId String
  sourceId String
  locator String
  candidate Json
  originalCandidate Json
  version Int @default(1)
  decision String @default("NEEDS_REVIEW")
  reason String?
  transactionId String?
  paymentId String?
  importBatchId String?
  reviewedByUserId String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  source FinancialSource @relation(fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  transaction FinanceTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  payment CardStatementPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  @@unique([sourceId, locator])
  @@index([workspaceId, decision])
  @@index([transactionId])
  @@index([paymentId])
  @@index([importBatchId])
}

model FinancialSnapshot {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  sourceId String
  locator String
  asOfDate DateTime @db.Date
  kind String
  payload Json
  statementId String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  source FinancialSource @relation(fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  @@unique([sourceId, locator])
  @@index([workspaceId, accountId, kind, asOfDate])
  @@index([statementId])
}

// Issuer payment evidence changes the liability; never salary or fabricated cash movement.
model CardStatementPayment {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  cardStatementId String?
  fingerprint String
  amountCents Int
  date DateTime @db.Date
  sourceId String
  locator String
  importBatchId String?
  createdAt DateTime @default(now())
  evidence FinancialEvidence[]
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  cardStatement CardStatement? @relation(fields: [cardStatementId, accountId, workspaceId], references: [id, accountId, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  @@unique([workspaceId, fingerprint])
  @@index([cardStatementId, accountId, workspaceId])
  @@index([workspaceId, accountId, date])
  @@index([importBatchId])
}

model TransactionRule {
  id             String           @id @default(cuid())
  workspaceId    String
  name           String
  field          String           @default("description")
  operator       String           @default("contains")
  value          String
  minAmountCents Int?
  maxAmountCents Int?
  accountId      String?
  source         String?
  categoryId     String?
  setMerchant    String?
  addTag         String?
  priority       Int              @default(100)
  isEnabled      Boolean          @default(true)
  createdAt      DateTime         @default(now())
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category       FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isEnabled, priority])
}

enum InvestmentAccountType {
  BROKERAGE
  BANK
  EXCHANGE
  WALLET
  REAL_ESTATE
  CUSTODY
  OTHER
}

enum InvestmentAssetType {
  CASH_EQUIVALENT
  SAVINGS
  CDB
  LCI
  LCA
  TREASURY
  DEBENTURE
  FIXED_INCOME_OTHER
  STOCK
  ETF
  BDR
  FII
  FIAGRO
  FUND
  CRYPTO
  REAL_ESTATE
  COMMODITY
  FOREIGN_ASSET
  OTHER
}

enum InvestmentTransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  DIVIDEND
  INTEREST
  FEE
  TAX
  TRANSFER
  SPLIT
  OTHER
}

enum InvestmentIncomeType {
  DIVIDEND
  JCP
  FII_DISTRIBUTION
  INTEREST
  COUPON
  RENT
  OTHER
}

enum InvestmentIndexer {
  CDI_PERCENTAGE
  CDI_SPREAD
  PREFIXED
  IPCA_SPREAD
  SELIC
  CUSTOM
}

enum InvestmentLiquidity {
  D0
  D1
  DN
  AT_MATURITY
  CUSTOM
  ILLIQUID
}

enum InvestmentBudgetMode {
  FIXED_AMOUNT
  INCOME_PERCENTAGE
  MANUAL
  REMAINING_CASH
}

enum InvestmentTradeDirection {
  LONG
  SHORT
}

enum InvestmentTradeStatus {
  OPEN
  CLOSED
  CANCELED
}

model InvestmentAccount {
  id                       String                  @id @default(cuid())
  workspaceId              String
  name                     String
  institution              String?
  type                     InvestmentAccountType   @default(BROKERAGE)
  currency                 String                  @default("BRL")
  linkedFinancialAccountId String?
  archivedAt               DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  workspace                Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedFinancialAccount   Account?                @relation("LinkedFinanceAccount", fields: [linkedFinancialAccountId], references: [id], onDelete: SetNull)
  positions                InvestmentPosition[]
  transactions             InvestmentTransaction[]
  income                   InvestmentIncome[]
  trades                   InvestmentTrade[]

  @@index([workspaceId, archivedAt])
  @@index([workspaceId, institution])
}

model InvestmentAsset {
  id                 String                        @id @default(cuid())
  workspaceId        String
  name               String
  ticker             String?
  exchange           String?
  currency           String                        @default("BRL")
  type               InvestmentAssetType
  sector             String?
  provider           String?
  providerAssetId    String?
  isManual           Boolean                       @default(true)
  archivedAt         DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  workspace          Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  positions          InvestmentPosition[]
  transactions       InvestmentTransaction[]
  income             InvestmentIncome[]
  prices             InvestmentPrice[]
  fixedIncomeProfile InvestmentFixedIncomeProfile?
  realEstateProfile  InvestmentRealEstateProfile?
  watchlistItems     InvestmentWatchlistItem[]
  researchNotes      InvestmentResearchNote[]
  goalLinks          InvestmentGoalLink[]
  alerts             InvestmentPriceAlert[]
  trades             InvestmentTrade[]

  @@index([workspaceId, type, archivedAt])
  @@index([workspaceId, ticker])
  @@index([provider, providerAssetId])
}

model InvestmentPosition {
  id                String            @id @default(cuid())
  workspaceId       String
  accountId         String
  assetId           String
  quantity          Decimal           @default(0) @db.Decimal(30, 12)
  bookCostCents     Int               @default(0)
  averagePriceCents Decimal           @default(0) @db.Decimal(30, 8)
  currentValueCents Int               @default(0)
  realizedPnlCents  Int               @default(0)
  lastValuedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account           InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset             InvestmentAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([accountId, assetId])
  @@index([workspaceId, assetId])
}

model InvestmentTransaction {
  id                        String                    @id @default(cuid())
  workspaceId               String
  accountId                 String
  assetId                   String?
  type                      InvestmentTransactionType
  date                      DateTime                  @db.Date
  quantity                  Decimal?                  @db.Decimal(30, 12)
  unitPriceCents            Decimal?                  @db.Decimal(30, 8)
  grossAmountCents          Int
  feesCents                 Int                       @default(0)
  taxesCents                Int                       @default(0)
  netAmountCents            Int
  currency                  String                    @default("BRL")
  source                    String                    @default("MANUAL")
  externalId                String?
  importBatchId             String?
  financeTransactionId      String?                   @unique
  fundingFinancialAccountId String?
  notes                     String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  workspace                 Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                   InvestmentAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset                     InvestmentAsset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  financeTransaction        FinanceTransaction?       @relation("InvestmentFinanceTransaction", fields: [financeTransactionId], references: [id], onDelete: SetNull)
  fundingFinancialAccount   Account?                  @relation("InvestmentFundingAccount", fields: [fundingFinancialAccountId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, externalId])
  @@index([workspaceId, date])
  @@index([workspaceId, assetId, date])
  @@index([workspaceId, accountId, date])
}

model InvestmentIncome {
  id                   String               @id @default(cuid())
  workspaceId          String
  accountId            String
  assetId              String?
  type                 InvestmentIncomeType
  amountCents          Int
  currency             String               @default("BRL")
  paymentDate          DateTime             @db.Date
  financeTransactionId String?              @unique
  source               String               @default("MANUAL")
  notes                String?
  createdAt            DateTime             @default(now())
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account              InvestmentAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset                InvestmentAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  financeTransaction   FinanceTransaction?  @relation("InvestmentIncomeFinanceTransaction", fields: [financeTransactionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, paymentDate])
  @@index([workspaceId, assetId, paymentDate])
}

model InvestmentPrice {
  id           String          @id @default(cuid())
  assetId      String
  priceCents   Decimal         @db.Decimal(30, 8)
  currency     String
  provider     String
  asOf         DateTime
  retrievedAt  DateTime        @default(now())
  delayMinutes Int?
  asset        InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, provider, asOf])
  @@index([assetId, asOf])
}

model InvestmentProductDefinition {
  id                           String                         @id @default(cuid())
  institution                  String
  product                      String
  assetType                    InvestmentAssetType
  indexer                      InvestmentIndexer
  indexerPercentageBasisPoints Int?
  spreadBasisPoints            Int?
  fixedRateBasisPoints         Int?
  eligibility                  String?
  eligibleLimitCents           Int?
  liquidity                    InvestmentLiquidity?
  validFrom                    DateTime                       @db.Date
  validUntil                   DateTime?                      @db.Date
  source                       String
  lastVerifiedAt               DateTime
  createdAt                    DateTime                       @default(now())
  fixedIncomeProfiles          InvestmentFixedIncomeProfile[]

  @@unique([institution, product, validFrom])
  @@index([institution, product, validUntil])
}

model InvestmentFixedIncomeProfile {
  id                           String                       @id @default(cuid())
  assetId                      String                       @unique
  productDefinitionId          String?
  issuer                       String
  principalCents               Int
  purchaseDate                 DateTime                     @db.Date
  maturityDate                 DateTime?                    @db.Date
  indexer                      InvestmentIndexer
  indexerPercentageBasisPoints Int?
  spreadBasisPoints            Int?
  fixedRateBasisPoints         Int?
  liquidity                    InvestmentLiquidity
  liquidityDays                Int?
  taxTreatment                 String                       @default("REGRESSIVE_IR")
  guaranteeMetadata            Json                         @default("{}")
  markToMarket                 Boolean                      @default(false)
  asset                        InvestmentAsset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productDefinition            InvestmentProductDefinition? @relation(fields: [productDefinitionId], references: [id], onDelete: SetNull)

  @@index([maturityDate])
}

model InvestmentRealEstateProfile {
  id                    String          @id @default(cuid())
  assetId               String          @unique
  purchasePriceCents    Int
  purchaseDate          DateTime        @db.Date
  estimatedValueCents   Int
  valuationDate         DateTime        @db.Date
  monthlyRentCents      Int             @default(0)
  financingBalanceCents Int             @default(0)
  monthlyCostsCents     Int             @default(0)
  vacancyBasisPoints    Int             @default(0)
  propertyType          String          @default("PROPERTY")
  asset                 InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model InvestmentBudget {
  id                          String               @id @default(cuid())
  workspaceId                 String
  month                       String
  mode                        InvestmentBudgetMode
  amountCents                 Int
  incomePercentageBasisPoints Int?
  reserveCents                Int                  @default(0)
  plan                        Json                 @default("{}")
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  workspace                   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month])
}

model InvestmentAllocationTarget {
  id                String              @id @default(cuid())
  workspaceId       String
  assetType         InvestmentAssetType
  targetBasisPoints Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, assetType])
}

model InvestmentPortfolioSnapshot {
  id                           String    @id @default(cuid())
  workspaceId                  String
  date                         DateTime  @db.Date
  investedCents                Int
  marketValueCents             Int
  cumulativeContributionsCents Int
  cumulativeIncomeCents        Int
  source                       String    @default("CALCULATED")
  createdAt                    DateTime  @default(now())
  workspace                    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
}

model InvestmentBenchmark {
  id            String    @id @default(cuid())
  workspaceId   String
  code          String
  value         Decimal   @db.Decimal(24, 10)
  referenceDate DateTime  @db.Date
  source        String
  retrievedAt   DateTime
  metadata      Json      @default("{}")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code, referenceDate])
  @@index([workspaceId, code, referenceDate])
}

model InvestmentWatchlist {
  id          String                    @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       InvestmentWatchlistItem[]

  @@unique([workspaceId, name])
}

model InvestmentWatchlistItem {
  id               String              @id @default(cuid())
  watchlistId      String
  assetId          String
  targetPriceCents Decimal?            @db.Decimal(30, 8)
  notes            String?
  addedAt          DateTime            @default(now())
  watchlist        InvestmentWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset            InvestmentAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, assetId])
}

model InvestmentResearchNote {
  id          String           @id @default(cuid())
  workspaceId String
  assetId     String?
  title       String
  content     String
  tags        String[]         @default([])
  sources     Json             @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset       InvestmentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, assetId])
}

model InvestmentMarketSnapshot {
  id          String   @id @default(cuid())
  key         String
  provider    String
  payload     Json
  asOf        DateTime
  retrievedAt DateTime @default(now())
  expiresAt   DateTime
  status      String   @default("FRESH")

  @@unique([key, provider])
  @@index([expiresAt])
}

model InvestmentGoalLink {
  id                    String           @id @default(cuid())
  workspaceId           String
  savingsGoalId         String
  assetId               String?
  allocationBasisPoints Int              @default(10000)
  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  savingsGoal           SavingsGoal      @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  asset                 InvestmentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([savingsGoalId, assetId])
  @@index([workspaceId, savingsGoalId])
}

model InvestmentTrade {
  id               String                   @id @default(cuid())
  workspaceId      String
  accountId        String
  assetId          String
  direction        InvestmentTradeDirection
  entryDate        DateTime
  entryPriceCents  Decimal                  @db.Decimal(30, 8)
  exitDate         DateTime?
  exitPriceCents   Decimal?                 @db.Decimal(30, 8)
  quantity         Decimal                  @db.Decimal(30, 12)
  feesCents        Int                      @default(0)
  taxesCents       Int                      @default(0)
  stopPriceCents   Decimal?                 @db.Decimal(30, 8)
  targetPriceCents Decimal?                 @db.Decimal(30, 8)
  strategy         String?
  setup            String?
  notes            String?
  attachmentUrls   String[]                 @default([])
  status           InvestmentTradeStatus    @default(OPEN)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account          InvestmentAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset            InvestmentAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entryDate])
  @@index([workspaceId, status])
  @@index([assetId, entryDate])
}

model InvestmentPriceAlert {
  id              String          @id @default(cuid())
  workspaceId     String
  assetId         String
  type            String
  targetValue     Decimal         @db.Decimal(30, 8)
  enabled         Boolean         @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime        @default(now())
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset           InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
}

model InvestmentMonthlyReview {
  id                    String    @id @default(cuid())
  workspaceId           String
  month                 String
  portfolioUpdated      Boolean   @default(false)
  contributionsReviewed Boolean   @default(false)
  allocationReviewed    Boolean   @default(false)
  maturitiesReviewed    Boolean   @default(false)
  goalsReviewed         Boolean   @default(false)
  completedAt           DateTime?
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  RECRUITER_CONTACT
  HR_INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Company {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  industry     String?
  notes        String?
  applications Application[]
  contacts     Contact[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, name])
}

model Application {
  id              String            @id @default(cuid())
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company           @relation(fields: [companyId, workspaceId], references: [id, workspaceId])
  jobTitle        String
  url             String?
  source          String            @default("Other")
  salaryMinCents  Int?
  salaryMaxCents  Int?
  currency        String            @default("BRL")
  location        String?
  workMode        WorkMode          @default(REMOTE)
  technologies    String[]          @default([])
  appliedAt       DateTime?
  status          ApplicationStatus @default(SAVED)
  statusChangedAt DateTime          @default(now())
  notes           String?
  nextActionDate  String?
  interviews      Interview[]
  offers          Offer[]
  documents       CareerDocument[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, nextActionDate])
}

model Contact {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId, workspaceId], references: [id, workspaceId])
  name        String
  email       String?
  role        String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, name])
}

model Interview {
  id              String      @id @default(cuid())
  workspaceId     String
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application @relation(fields: [applicationId, workspaceId], references: [id, workspaceId])
  title           String
  scheduledAt     DateTime
  durationMinutes Int         @default(60)
  location        String?
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([workspaceId, scheduledAt])
}

model Offer {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId, workspaceId], references: [id, workspaceId])
  salaryCents   Int
  currency      String      @default("BRL")
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([workspaceId])
}

model CareerDocument {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId, workspaceId], references: [id, workspaceId])
  name          String
  url           String
  type          String       @default("CV")
  createdAt     DateTime     @default(now())

  @@index([workspaceId])
}
