// Generated by npm run prisma:assemble from the reviewed domain fragments.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  isGlobalAdmin  Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  sessions       UserSession[]
  notifications  Notification[]
  activityEvents ActivityEvent[]
}

model Workspace {
  habits              Habit[]
  habitSchedules      HabitSchedule[]
  habitEntries        HabitEntry[]
  tasks               Task[]
  projects            Project[]
  goals               Goal[]
  accounts            Account[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]
  budgets             Budget[]
  subscriptions       Subscription[]
  debts               Debt[]
  savingsGoals        SavingsGoal[]
  importBatches       ImportBatch[]
  importMappings      ImportMapping[]
  transactionRules    TransactionRule[]
  companies           Company[]
  applications        Application[]
  contacts            Contact[]
  interviews          Interview[]
  offers              Offer[]
  careerDocuments     CareerDocument[]
  id                  String                     @id @default(cuid())
  name                String
  slug                String                     @unique
  timezone            String                     @default("America/Manaus")
  locale              String                     @default("pt-BR")
  currency            String                     @default("BRL")
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  memberships         Membership[]
  sessions            UserSession[]
  activityEvents      ActivityEvent[]
  notifications       Notification[]
  subscription        WorkspaceSubscription?
  featureOverrides    WorkspaceFeatureOverride[]
  usageCounters       UsageCounter[]
  storageFiles        StorageFile[]
  rolePermissions     RolePermission[]
}

model Membership {
  id                  String                     @id @default(cuid())
  workspaceId         String
  userId              String
  role                MembershipRole             @default(MEMBER)
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionOverrides MemberPermissionOverride[]

  @@unique([workspaceId, userId])
  @@index([userId, isActive])
}

model UserSession {
  id               String        @id @default(cuid())
  userId           String
  workspaceId      String
  sessionTokenHash String        @unique
  status           SessionStatus @default(ACTIVE)
  userAgent        String?
  expiresAt        DateTime
  lastSeenAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  revokedAt        DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([workspaceId, status])
}

model ActivityEvent {
  id          String    @id @default(cuid())
  workspaceId String
  type        String
  entityType  String
  entityId    String
  actorUserId String?
  metadata    Json      @default("{}")
  source      String    @default("MANUAL")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  body        String
  href        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}

model Permission {
  id              String                     @id @default(cuid())
  key             String                     @unique
  description     String
  rolePermissions RolePermission[]
  overrides       MemberPermissionOverride[]
}

model RolePermission {
  id           String         @id @default(cuid())
  workspaceId  String
  role         MembershipRole
  permissionId String
  enabled      Boolean        @default(true)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role, permissionId])
}

model MemberPermissionOverride {
  id           String           @id @default(cuid())
  membershipId String
  permissionId String
  effect       PermissionEffect
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permissionId])
}

model SubscriptionPlan {
  id            String                  @id @default(cuid())
  code          String                  @unique
  name          String
  description   String?
  priceCents    Int?
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  featureLimits FeatureLimit[]
  subscriptions WorkspaceSubscription[]
}

model FeatureLimit {
  id      String           @id @default(cuid())
  planId  String
  key     String
  enabled Boolean          @default(true)
  limit   Int?
  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model WorkspaceSubscription {
  id          String           @id @default(cuid())
  workspaceId String           @unique
  planId      String
  status      BillingStatus    @default(TRIAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
}

model WorkspaceFeatureOverride {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  enabled     Boolean   @default(true)
  limit       Int?
  expiresAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model UsageCounter {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  periodStart DateTime
  count       Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, periodStart])
}

model StorageFile {
  id               String    @id @default(cuid())
  workspaceId      String
  storageKey       String    @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  purpose          String
  uploadedByUserId String
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, purpose])
}

model AuthAttempt {
  key         String   @id
  attempts    Int      @default(1)
  windowStart DateTime @default(now())
}

enum HabitType {
  BOOLEAN
  QUANTITY
  DURATION
  PAGES
  DISTANCE
  MONEY
  CUSTOM
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Habit {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  icon        String         @default("◉")
  color       String         @default("#10b981")
  type        HabitType      @default(BOOLEAN)
  target      Float          @default(1)
  unit        String         @default("vezes")
  frequency   HabitFrequency @default(DAILY)
  startDate   String
  endDate     String?
  isArchived  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  schedule    HabitSchedule?
  entries     HabitEntry[]

  @@index([workspaceId, isArchived])
}

model HabitSchedule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  habitId     String    @unique
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  days        Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  time        String?
  monthlyDay  Int?

  @@index([workspaceId])
}

model HabitEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date        String
  value       Float     @default(0)
  completed   Boolean   @default(false)
  note        String?
  source      String    @default("MANUAL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([habitId, date])
  @@index([workspaceId, date])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ARCHIVED
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String        @default("#6366f1")
  icon        String        @default("◈")
  status      ProjectStatus @default(ACTIVE)
  startDate   String?
  targetDate  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks       Task[]

  @@index([workspaceId, status])
}

model Task {
  id                String       @id @default(cuid())
  workspaceId       String
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TODO)
  dueDate           String?
  scheduledAt       DateTime?
  estimatedDuration Int?
  tags              String[]     @default([])
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([workspaceId, status, dueDate])
  @@index([projectId])
}

model Goal {
  id             String     @id @default(cuid())
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           String     @default("NUMERIC")
  target         Float
  current        Float      @default(0)
  unit           String     @default("unidades")
  targetDate     String?
  status         GoalStatus @default(ACTIVE)
  linkedModule   String?
  linkedEntityId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([workspaceId, status])
}

// Finance fragment; merged into the baseline by the root agent.
enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
  DIGITAL_WALLET
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  ADJUSTMENT
}

model Account {
  id                   String               @id @default(cuid())
  workspaceId          String
  name                 String
  type                 AccountType          @default(CHECKING)
  institution          String?
  currency             String               @default("BRL")
  initialBalanceCents  Int                  @default(0)
  creditLimitCents     Int?
  closingDay           Int?
  dueDay               Int?
  isArchived           Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions         FinanceTransaction[] @relation("OriginAccount")
  incomingTransactions FinanceTransaction[] @relation("DestinationAccount")
  subscriptions        Subscription[]
  savingsGoals         SavingsGoal[]
  importBatches        ImportBatch[]

  @@index([workspaceId, isArchived])
}

model FinanceCategory {
  id            String               @id @default(cuid())
  workspaceId   String
  name          String
  type          String               @default("EXPENSE")
  icon          String               @default("tag")
  color         String               @default("#8b8ef5")
  parentId      String?
  isSystem      Boolean              @default(false)
  isArchived    Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent        FinanceCategory?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      FinanceCategory[]    @relation("CategoryTree")
  transactions  FinanceTransaction[]
  budgets       Budget[]
  subscriptions Subscription[]
  rules         TransactionRule[]

  @@unique([workspaceId, name])
}

model FinanceTransaction {
  id                   String           @id @default(cuid())
  workspaceId          String
  accountId            String
  destinationAccountId String?
  categoryId           String?
  type                 TransactionType
  description          String
  merchant             String?
  amountCents          Int
  currency             String           @default("BRL")
  date                 DateTime         @db.Date
  competenceDate       DateTime?        @db.Date
  installmentNumber    Int?
  installmentTotal     Int?
  recurring            Boolean          @default(false)
  recurringGroupId     String?
  tags                 String[]         @default([])
  notes                String?
  source               String           @default("MANUAL")
  externalId           String?
  fingerprint          String?
  importBatchId        String?
  revision             Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account              Account          @relation("OriginAccount", fields: [accountId], references: [id])
  destinationAccount   Account?         @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  category             FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch          ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, date])
  @@index([workspaceId, accountId, date])
  @@index([workspaceId, importBatchId])
}

model Budget {
  id          String          @id @default(cuid())
  workspaceId String
  categoryId  String
  period      String          @default("MONTHLY")
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  limitCents  Int
  currency    String          @default("BRL")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    FinanceCategory @relation(fields: [categoryId], references: [id])

  @@unique([workspaceId, categoryId, startDate, endDate])
}

model Subscription {
  id             String           @id @default(cuid())
  workspaceId    String
  name           String
  merchant       String?
  amountCents    Int
  currency       String           @default("BRL")
  billingCycle   String           @default("MONTHLY")
  customDays     Int?
  nextChargeDate DateTime         @db.Date
  accountId      String?
  categoryId     String?
  startedAt      DateTime         @db.Date
  status         String           @default("ACTIVE")
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account        Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category       FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, nextChargeDate])
}

model Debt {
  id                    String    @id @default(cuid())
  workspaceId           String
  name                  String
  originalAmountCents   Int
  remainingBalanceCents Int
  currency              String    @default("BRL")
  interestBasisPoints   Int       @default(0)
  ratePeriod            String    @default("MONTHLY")
  minimumPaymentCents   Int
  installments          Int?
  dueDay                Int?
  startDate             DateTime  @db.Date
  targetPayoffDate      DateTime? @db.Date
  status                String    @default("ACTIVE")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model SavingsGoal {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  targetAmountCents  Int
  currentAmountCents Int       @default(0)
  currency           String    @default("BRL")
  targetDate         DateTime? @db.Date
  linkedAccountId    String?
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedAccount      Account?  @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

model ImportBatch {
  id              String               @id @default(cuid())
  workspaceId     String
  accountId       String
  status          String               @default("UPLOADED")
  source          String               @default("CSV")
  fileName        String
  fileSize        Int
  rawContent      String?
  mapping         Json?
  preview         Json?
  rowCount        Int                  @default(0)
  importedCount   Int                  @default(0)
  duplicateCount  Int                  @default(0)
  failedCount     Int                  @default(0)
  rolledBackCount Int                  @default(0)
  preservedCount  Int                  @default(0)
  createdAt       DateTime             @default(now())
  completedAt     DateTime?
  rolledBackAt    DateTime?
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         Account              @relation(fields: [accountId], references: [id])
  transactions    FinanceTransaction[]

  @@index([workspaceId, createdAt])
}

model ImportMapping {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  source      String    @default("CSV")
  mapping     Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model TransactionRule {
  id             String           @id @default(cuid())
  workspaceId    String
  name           String
  field          String           @default("description")
  operator       String           @default("contains")
  value          String
  minAmountCents Int?
  maxAmountCents Int?
  accountId      String?
  source         String?
  categoryId     String?
  setMerchant    String?
  addTag         String?
  priority       Int              @default(100)
  isEnabled      Boolean          @default(true)
  createdAt      DateTime         @default(now())
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category       FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isEnabled, priority])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  RECRUITER_CONTACT
  HR_INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Company {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  industry     String?
  notes        String?
  applications Application[]
  contacts     Contact[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, name])
}

model Application {
  id              String            @id @default(cuid())
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company           @relation(fields: [companyId, workspaceId], references: [id, workspaceId])
  jobTitle        String
  url             String?
  source          String            @default("Other")
  salaryMinCents  Int?
  salaryMaxCents  Int?
  currency        String            @default("BRL")
  location        String?
  workMode        WorkMode          @default(REMOTE)
  technologies    String[]          @default([])
  appliedAt       DateTime?
  status          ApplicationStatus @default(SAVED)
  statusChangedAt DateTime          @default(now())
  notes           String?
  nextActionDate  String?
  interviews      Interview[]
  offers          Offer[]
  documents       CareerDocument[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, nextActionDate])
}

model Contact {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId, workspaceId], references: [id, workspaceId])
  name        String
  email       String?
  role        String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, name])
}

model Interview {
  id              String      @id @default(cuid())
  workspaceId     String
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application @relation(fields: [applicationId, workspaceId], references: [id, workspaceId])
  title           String
  scheduledAt     DateTime
  durationMinutes Int         @default(60)
  location        String?
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([workspaceId, scheduledAt])
}

model Offer {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId, workspaceId], references: [id, workspaceId])
  salaryCents   Int
  currency      String      @default("BRL")
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([workspaceId])
}

model CareerDocument {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId, workspaceId], references: [id, workspaceId])
  name          String
  url           String
  type          String       @default("CV")
  createdAt     DateTime     @default(now())

  @@index([workspaceId])
}
