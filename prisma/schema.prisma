model PatientNoteTag {
  noteId String
  tagId  String

  note PatientNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  PatientTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("patient_note_tags")
}

