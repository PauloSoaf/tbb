// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  NUTRITIONIST
  ASSISTANT
  OWNER
  SECRETARY
  GLOBAL_ADMIN
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AnamneseStatus {
  NEW
  REVIEWED
  ARCHIVED
}

enum AppointmentMode {
  ONLINE
  PRESENTIAL
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELED
}

enum DocumentType {
  EXAM
  LAB_RESULT
  ANAMNESE_PDF
  MEAL_PLAN
  OTHER
}

enum MeasurementSource {
  MANUAL
  BIOIMPEDANCE
  SKINFOLD
  PHOTO_ESTIMATION
}

enum TemplateType {
  TEXT
  FILE
}

enum MealPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MealItemSource {
  TACO
  CUSTOM
}

enum SubstitutionGroupType {
  ITEM_REPLACEMENT
  MEAL_OPTION
}

enum EquivalenceBasis {
  CALORIES
  MACROS
  CARBS
  PROTEIN
  FAT
  PORTION
  FOOD_GROUP
  MANUAL
}

enum SubstitutionItemSource {
  TACO
  CUSTOM
}

enum FoodDiaryMeal {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  SUPPER
  OTHER
}

enum ChatMessageSender {
  PATIENT
  NUTRITIONIST
}

enum PatientAccountStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum CareSessionStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum CareSessionMode {
  VIDEO
  AUDIO
  IN_PERSON
}

enum CareSessionActor {
  NUTRITIONIST
  PATIENT
  SYSTEM
}

enum TranscriptStatus {
  NOT_STARTED
  RECORDING
  LIVE
  PAUSED
  STOPPED
  PROCESSING
  COMPLETED
  SAVED
  DISCARDED
  FAILED
}

enum CareSessionProvider {
  NATIVE_WEBRTC
  GOOGLE_MEET
  JITSI_LEGACY
  EXTERNAL_LINK
}

enum CareSessionJoinRole {
  NUTRITIONIST
  PATIENT
}

enum ShoppingListStatus {
  ACTIVE
  ARCHIVED
}

enum ShoppingListItemSource {
  MEAL_PLAN
  MANUAL
  SUBSTITUTION
}

enum ShoppingListCategory {
  FRUITS
  VEGETABLES
  PROTEINS
  GRAINS
  DAIRY
  LEGUMES
  OILS
  SEASONINGS
  BEVERAGES
  SUPPLEMENTS
  OTHER
}

enum HouseholdMeasureType {
  SPOON
  CUP
  GLASS
  LADLE
  PLATE
  SLICE
  UNIT
  PIECE
  SCOOP
  PORTION
  CUSTOM
}

enum HouseholdMeasureSize {
  TEA_SPOON
  DESSERT_SPOON
  TABLE_SPOON
  SERVING_SPOON
  COFFEE_CUP
  TEA_CUP
  AMERICAN_GLASS
  COMMON_GLASS
  SMALL
  MEDIUM
  LARGE
  CUSTOM
}

enum HouseholdMeasureSource {
  TBCA
  TACO
  USDA_FDC
  ANVISA
  PINHEIRO
  PACHECO
  MANUAL
  CURATED
  NUTRITIONIST_CUSTOM
}

enum HouseholdMeasureConfidence {
  LOW
  MEDIUM
  HIGH
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Nutritionist {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  crn               String
  bio               String?
  calendarToken     String?  @unique
  whatsapp          String?
  email             String
  clinicAddress     String?
  city              String
  state             String
  profileImageUrl   String?
  themePrimaryColor String   @default("#2563EB")
  specialties       String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                      User[]
  patients                   Patient[]
  anamneseResponses          AnamneseResponse[]
  appointments               Appointment[]
  patientMeasurements        PatientMeasurement[]
  documents                  Document[]
  templates                  Template[]
  mealPlans                  MealPlan[]
  meals                      Meal[]
  mealItems                  MealItem[]
  mealPlanLibraryMeals       MealPlanLibraryMeal[]
  mealPlanLibraryFoods       MealPlanLibraryFood[]
  mealSubstitutionGroups     MealSubstitutionGroup[]
  mealSubstitutionItems      MealSubstitutionItem[]
  customStickers             CustomSticker[]
  patientAccounts            PatientAccount[]
  foodDiaryEntries           FoodDiaryEntry[]
  chatMessages               ChatMessage[]
  careSessions               CareSession[]
  careSessionMessages        CareSessionMessage[]
  careSessionAttachments     CareSessionAttachment[]
  patientNotes               PatientNote[]
  patientTags                PatientTag[]
  patientTasks               PatientTask[]
  skinfoldAssessments        SkinfoldAssessment[]
  patientGoals               PatientGoal[]
  patientReminders           PatientReminder[]
  wellnessCheckins           WellnessCheckin[]
  teamMembers                TeamMember[]
  teamInvites                TeamInvite[]
  shoppingLists              ShoppingList[]
  shoppingListItems          ShoppingListItem[]
  customHouseholdMeasures    FoodHouseholdMeasure[]
  transcriptions             ConsultationTranscription[]
  transcriptionSegments      ConsultationTranscriptionSegment[]
  transcriptionSettings      TranscriptionSettings?
  appointmentTranscripts     AppointmentTranscript[]
  transcriptionUsageCounters TranscriptionUsageCounter[]

  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?
  googleCalendarId     String?

  auditLogs        AuditLog[]
  subscription     TenantSubscription?
  usageCounters    UsageCounter[]
  storageFiles     StorageFile[]
  storageSnapshots StorageUsageSnapshot[]
  featureOverrides TenantFeatureOverride[]

  @@map("nutritionists")
}

model CustomSticker {
  id             String   @id @default(cuid())
  nutritionistId String
  imageUrl       String
  createdAt      DateTime @default(now())

  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@map("custom_stickers")
}

model User {
  id             String @id @default(cuid())
  nutritionistId String
  name           String
  email          String @unique
  passwordHash   String
  role           Role   @default(NUTRITIONIST)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist                Nutritionist            @relation(fields: [nutritionistId], references: [id])
  teamMembers                 TeamMember[]
  auditLogsActor              AuditLog[]              @relation("ActorUser")
  sessions                    UserSession[]
  savedAppointmentTranscripts AppointmentTranscript[] @relation("TranscriptSavedBy")

  @@map("users")
}

model Patient {
  id             String        @id @default(cuid())
  nutritionistId String
  name           String
  email          String?
  phone          String
  birthDate      DateTime?
  gender         String?
  weight         Float?
  height         Float?
  goal           String?
  notes          String?
  status         PatientStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist           Nutritionist                @relation(fields: [nutritionistId], references: [id])
  anamneseResponses      AnamneseResponse[]
  appointments           Appointment[]
  patientMeasurements    PatientMeasurement[]
  documents              Document[]
  mealPlans              MealPlan[]
  patientAccount         PatientAccount?
  foodDiaryEntries       FoodDiaryEntry[]
  chatMessages           ChatMessage[]
  careSessions           CareSession[]
  careSessionMessages    CareSessionMessage[]
  careSessionAttachments CareSessionAttachment[]
  patientNotes           PatientNote[]
  patientTags            PatientTag[]
  patientTasks           PatientTask[]
  skinfoldAssessments    SkinfoldAssessment[]
  patientGoals           PatientGoal[]
  patientReminders       PatientReminder[]
  wellnessCheckins       WellnessCheckin[]
  shoppingLists          ShoppingList[]
  transcriptions         ConsultationTranscription[]
  appointmentTranscripts AppointmentTranscript[]
  consentRecords         ConsentRecord[]
  dataSubjectRequests    DataSubjectRequest[]

  @@unique([nutritionistId, phone])
  @@map("patients")
}

model AnamneseResponse {
  id              String         @id @default(cuid())
  nutritionistId  String
  patientId       String
  payload         Json
  summary         String?
  attentionPoints String[]
  status          AnamneseStatus @default(NEW)
  submittedAt     DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@map("anamnese_responses")
}

model Appointment {
  id             String            @id @default(cuid())
  nutritionistId String
  patientId      String
  date           DateTime
  startTime      String?
  endTime        String?
  mode           AppointmentMode   @default(PRESENTIAL)
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist            @relation(fields: [nutritionistId], references: [id])
  patient      Patient                 @relation(fields: [patientId], references: [id])
  careSessions CareSession[]
  transcripts  AppointmentTranscript[]

  @@map("appointments")
}

model PatientMeasurement {
  id             String @id @default(cuid())
  nutritionistId String
  patientId      String

  weight            Float?
  height            Float?
  bmi               Float?
  bmiClassification String?

  waist            Float?
  hip              Float?
  waistHipRatio    Float?
  waistHeightRatio Float?
  waistHipRisk     String?
  waistHeightRisk  String?

  // Snapshot of the clinical reference used at the time of this assessment.
  // These fields intentionally live on the measurement so historic results do
  // not change when a patient's demographic record is updated later.
  assessmentProfile String?
  assessmentAge     Int?
  biologicalSex     String?

  neck          Float?
  chest         Float?
  abdomen       Float?
  relaxedArm    Float?
  contractedArm Float?
  forearm       Float?
  thigh         Float?
  calf          Float?

  bodyFatPercentage Float?
  bodyFatKg         Float?
  leanMassKg        Float?

  // Optional data calculated from the clinical skinfold panel. The detailed
  // readings are kept as versioned JSON while the summary columns remain easy
  // to query in reports and evolution cards.
  skinfoldProtocol     String?
  skinfoldMeasurements Json?
  skinfoldSum          Float?
  skinfoldBodyDensity  Float?
  skinfoldFormula      String?

  source MeasurementSource @default(MANUAL)
  notes  String?

  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([nutritionistId])
  @@index([patientId])
  @@index([nutritionistId, patientId])
  @@index([measuredAt])
  @@map("patient_measurements")
}

model Document {
  id             String       @id @default(cuid())
  nutritionistId String
  patientId      String
  type           DocumentType @default(OTHER)
  fileName       String
  fileUrl        String
  mimeType       String?
  size           Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visibleToPatient Boolean @default(false)

  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@map("documents")
}

model Template {
  id             String       @id @default(cuid())
  nutritionistId String
  title          String
  type           TemplateType @default(TEXT)

  content String? // Used if type is TEXT

  fileName String? // Used if type is FILE
  fileUrl  String?
  mimeType String?
  size     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id])

  @@map("templates")
}

model MealPlan {
  id             String         @id @default(cuid())
  nutritionistId String
  patientId      String?
  isTemplate     Boolean        @default(false)
  title          String
  description    String?
  objective      String?
  status         MealPlanStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  totalCalories  Float          @default(0)
  totalProtein   Float          @default(0)
  totalCarbs     Float          @default(0)
  totalFat       Float          @default(0)
  notes          String?

  // Studio fields
  layoutMode       String?   @default("CLINICAL")
  coverImageUrl    String?
  contentBlocks    Json?
  pdfStyle         Json?
  templateCategory String?
  templateTags     String[]
  lastEditedAt     DateTime?
  targetCalories   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist       Nutritionist            @relation(fields: [nutritionistId], references: [id])
  patient            Patient?                @relation(fields: [patientId], references: [id])
  meals              Meal[]
  substitutionGroups MealSubstitutionGroup[]
  shoppingLists      ShoppingList[]

  @@map("meal_plans")
}

model Meal {
  id             String  @id @default(cuid())
  nutritionistId String
  mealPlanId     String
  name           String
  time           String?
  position       Int     @default(0)
  notes          String?
  imageUrl       String?
  imageAlt       String?
  imageCaption   String?
  showImageInPdf Boolean @default(true)
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist       Nutritionist            @relation(fields: [nutritionistId], references: [id])
  mealPlan           MealPlan                @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items              MealItem[]
  substitutionGroups MealSubstitutionGroup[]

  @@map("meals")
}

model MealItem {
  id                     String         @id @default(cuid())
  nutritionistId         String
  mealId                 String
  foodName               String
  source                 MealItemSource @default(CUSTOM)
  tacoFoodId             String?
  quantity               Float
  unit                   String
  householdMeasure       String?
  householdMeasureSource String?
  imageUrl               String?
  imageAlt               String?
  imageCaption           String?
  showImageInPdf         Boolean        @default(true)
  calories               Float          @default(0)
  protein                Float          @default(0)
  carbs                  Float          @default(0)
  fat                    Float          @default(0)
  fiber                  Float?
  sodium                 Float?
  notes                  String?
  position               Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist       Nutritionist            @relation(fields: [nutritionistId], references: [id])
  meal               Meal                    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  substitutionGroups MealSubstitutionGroup[]

  @@map("meal_items")
}

model MealPlanLibraryFood {
  id                     String         @id @default(cuid())
  nutritionistId         String
  name                   String
  source                 MealItemSource @default(CUSTOM)
  tacoFoodId             String?
  defaultQuantity        Float
  unit                   String
  householdMeasure       String?
  householdMeasureSource String?
  calories               Float          @default(0)
  protein                Float          @default(0)
  carbs                  Float          @default(0)
  fat                    Float          @default(0)
  fiber                  Float?
  sodium                 Float?
  notes                  String?
  presentation           Json?
  timesUsed              Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@index([nutritionistId, updatedAt])
  @@index([nutritionistId, name])
  @@map("meal_plan_library_foods")
}

model MealPlanLibraryMeal {
  id             String   @id @default(cuid())
  nutritionistId String
  name           String
  defaultTime    String?
  notes          String?
  presentation   Json?
  timesUsed      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nutritionist Nutritionist              @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  items        MealPlanLibraryMealItem[]

  @@index([nutritionistId, updatedAt])
  @@index([nutritionistId, name])
  @@map("meal_plan_library_meals")
}

model MealPlanLibraryMealItem {
  id                     String         @id @default(cuid())
  savedMealId            String
  name                   String
  source                 MealItemSource @default(CUSTOM)
  tacoFoodId             String?
  quantity               Float
  unit                   String
  householdMeasure       String?
  householdMeasureSource String?
  calories               Float          @default(0)
  protein                Float          @default(0)
  carbs                  Float          @default(0)
  fat                    Float          @default(0)
  fiber                  Float?
  sodium                 Float?
  notes                  String?
  position               Int            @default(0)
  presentation           Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  savedMeal MealPlanLibraryMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)

  @@index([savedMealId, position])
  @@map("meal_plan_library_meal_items")
}

// ─── Portal do Paciente ───────────────────────────────────────────────────────

model MealSubstitutionGroup {
  id String @id @default(cuid())

  nutritionistId String
  mealPlanId     String
  mealId         String?
  baseMealItemId String?

  type SubstitutionGroupType @default(ITEM_REPLACEMENT)

  title            String
  description      String?
  equivalenceBasis EquivalenceBasis @default(MANUAL)

  targetCalories Float?
  targetProtein  Float?
  targetCarbs    Float?
  targetFat      Float?
  targetQuantity Float?
  targetUnit     String?

  visibleToPatient Boolean @default(true)
  notes            String?
  position         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  mealPlan     MealPlan     @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meal         Meal?        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  baseMealItem MealItem?    @relation(fields: [baseMealItemId], references: [id], onDelete: SetNull)

  items MealSubstitutionItem[]

  @@index([nutritionistId])
  @@index([mealPlanId])
  @@index([mealId])
  @@index([baseMealItemId])
  @@index([visibleToPatient])
  @@map("meal_substitution_groups")
}

model MealSubstitutionItem {
  id String @id @default(cuid())

  nutritionistId String
  groupId        String

  foodName   String
  source     SubstitutionItemSource @default(CUSTOM)
  tacoFoodId String?

  quantity         Float?
  unit             String?
  householdMeasure String?

  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?
  sodium   Float?

  equivalenceNotes String?
  position         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist          @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  group        MealSubstitutionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([nutritionistId])
  @@index([groupId])
  @@index([position])
  @@map("meal_substitution_items")
}

model PatientAccount {
  id             String               @id @default(cuid())
  patientId      String               @unique
  nutritionistId String
  email          String
  passwordHash   String
  status         PatientAccountStatus @default(PENDING)

  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  activatedAt              DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@index([nutritionistId])
  @@index([email])
  @@map("patient_accounts")
}

model FoodDiaryEntry {
  id             String        @id @default(cuid())
  patientId      String
  nutritionistId String
  meal           FoodDiaryMeal @default(OTHER)
  foodName       String
  quantity       Float?
  unit           String?
  calories       Float?
  protein        Float?
  carbs          Float?
  fat            Float?
  hunger         Int?
  satiety        Int?
  mood           String?
  notes          String?
  imageUrl       String?
  loggedAt       DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([nutritionistId])
  @@index([loggedAt])
  @@map("food_diary_entries")
}

model ChatMessage {
  id             String            @id @default(cuid())
  patientId      String
  nutritionistId String
  sender         ChatMessageSender
  body           String
  attachmentUrl  String?
  readAt         DateTime?

  createdAt DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([nutritionistId])
  @@index([createdAt])
  @@map("chat_messages")
}

model CareSession {
  id             String  @id @default(cuid())
  nutritionistId String
  patientId      String
  appointmentId  String?

  title  String?
  status CareSessionStatus @default(SCHEDULED)
  mode   CareSessionMode   @default(VIDEO)

  roomProvider String?
  roomId       String?
  roomUrl      String?

  provider              CareSessionProvider @default(JITSI_LEGACY)
  externalMeetingUrl    String?
  googleMeetSpaceName   String?
  googleMeetUri         String?
  googleMeetMeetingCode String?
  nativeRoomName        String?
  nativeSignalChannel   String?

  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  patientJoinedAt      DateTime?
  nutritionistJoinedAt DateTime?

  notes               String?
  clinicalSummary     String?
  patientInstructions String?
  transcriptText      String?
  transcriptStatus    TranscriptStatus @default(NOT_STARTED)

  consentForRecording     Boolean @default(false)
  consentForTranscription Boolean @default(false)

  patientJoinTokenHash      String?
  patientJoinTokenExpiresAt DateTime?
  patientJoinTokenUsedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist            @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patient      Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  messages     CareSessionMessage[]
  attachments  CareSessionAttachment[]
  transcripts  AppointmentTranscript[]

  @@index([nutritionistId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@index([startedAt])
  @@index([provider])
  @@map("care_sessions")
}

model CareSessionMessage {
  id             String @id @default(cuid())
  nutritionistId String
  careSessionId  String
  patientId      String

  sender        CareSessionActor
  body          String
  attachmentUrl String?
  readAt        DateTime?

  createdAt DateTime @default(now())

  careSession  CareSession  @relation(fields: [careSessionId], references: [id], onDelete: Cascade)
  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([nutritionistId])
  @@index([careSessionId])
  @@index([patientId])
  @@index([createdAt])
  @@map("care_session_messages")
}

model CareSessionAttachment {
  id             String @id @default(cuid())
  nutritionistId String
  careSessionId  String
  patientId      String

  fileName   String
  fileUrl    String
  mimeType   String?
  sizeBytes  Int?
  uploadedBy CareSessionActor

  createdAt DateTime @default(now())

  careSession  CareSession  @relation(fields: [careSessionId], references: [id], onDelete: Cascade)
  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([nutritionistId])
  @@index([careSessionId])
  @@index([patientId])
  @@map("care_session_attachments")
}

model CareSessionSignal {
  id             String              @id @default(cuid())
  nutritionistId String
  careSessionId  String
  senderRole     CareSessionJoinRole
  type           String
  payload        Json
  processed      Boolean             @default(false)
  createdAt      DateTime            @default(now())

  @@index([nutritionistId])
  @@index([careSessionId])
  @@index([createdAt])
  @@map("care_session_signals")
}

// ─── Sprint E: Prontuário 360 ─────────────────────────────────────────────────

enum PatientTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum PatientTaskPriority {
  LOW
  MEDIUM
  HIGH
}

model PatientNote {
  id             String @id @default(cuid())
  nutritionistId String
  patientId      String

  title    String?
  body     String
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist     @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tags         PatientNoteTag[]

  @@index([nutritionistId])
  @@index([patientId])
