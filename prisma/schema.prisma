model PatientTag {
  id             String @id @default(cuid())
  nutritionistId String
  patientId      String
  label          String
  color          String @default("#6366f1")

  createdAt DateTime @default(now())

  nutritionist Nutritionist     @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  notes        PatientNoteTag[]

  @@unique([nutritionistId, patientId, label])
  @@index([nutritionistId])
  @@index([patientId])
  @@map("patient_tags")
}

model PatientTask {
  id             String              @id @default(cuid())
  nutritionistId String
  patientId      String
  title          String
  description    String?
  status         PatientTaskStatus   @default(PENDING)
  priority       PatientTaskPriority @default(MEDIUM)
  dueDate        DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([nutritionistId])
  @@index([patientId])
  @@index([status])
  @@map("patient_tasks")
