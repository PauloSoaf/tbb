// ─── Sprint Transcrição de Atendimentos ──────────────────────────────────────

enum TranscriptionProvider {
  MANUAL
  LOCAL_WHISPER
  CUSTOM_HTTP
  OPENAI_WHISPER_API
  ELEVENLABS
  NOTTA_EXTERNAL
}

enum TranscriptionStatus {
  NOT_STARTED
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
  REVIEWED
  APPROVED
  REJECTED
}

enum TranscriptionSourceType {
  CARE_SESSION
  APPOINTMENT
  MANUAL_NOTE
  UPLOADED_AUDIO
  UPLOADED_VIDEO
}

enum TranscriptionVisibility {
  NUTRITIONIST_ONLY
  PATIENT_VISIBLE
}

model ConsultationTranscription {
  id String @id @default(cuid())

  nutritionistId String
  patientId      String

  careSessionId String?
  appointmentId String?

  provider   TranscriptionProvider   @default(MANUAL)
  status     TranscriptionStatus     @default(NOT_STARTED)
  sourceType TranscriptionSourceType @default(CARE_SESSION)
  visibility TranscriptionVisibility @default(NUTRITIONIST_ONLY)

  title    String?
  language String? @default("pt-BR")

  audioUrl             String?
  audioStorageKey      String?
  audioMimeType        String?
  audioSizeBytes       Int?
  audioDurationSeconds Int?

  rawTranscript          String?
  editedTranscript       String?
  clinicalSummary        String?
  patientFriendlySummary String?

  aiRawResult Json?
  confidence  Float?

  consentForRecording     Boolean   @default(false)
  consentForTranscription Boolean   @default(false)
  consentCollectedAt      DateTime?

  reviewedAt DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionist Nutritionist                       @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patient      Patient                            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  segments     ConsultationTranscriptionSegment[]

  @@index([nutritionistId])
  @@index([patientId])
  @@index([careSessionId])
  @@index([appointmentId])
  @@index([status])
  @@index([createdAt])
  @@map("consultation_transcriptions")
}

model ConsultationTranscriptionSegment {
  id String @id @default(cuid())

  nutritionistId  String
  transcriptionId String

  speakerLabel String?
  speakerRole  String?

  startSeconds Float?
  endSeconds   Float?

  text       String
  confidence Float?
  position   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transcription ConsultationTranscription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)
  nutritionist  Nutritionist              @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)

  @@index([nutritionistId])
  @@index([transcriptionId])
  @@index([position])
  @@map("consultation_transcription_segments")
}

enum TranscriptSpeakerSource {
  NUTRITIONIST
  PATIENT
  TEAM_MEMBER
  IN_PERSON_ROOM
  UNKNOWN
}

model TranscriptionSettings {
  id                             String   @id @default(cuid())
  tenantId                       String   @unique
  enabled                        Boolean  @default(false)
  autoStartOnlineAppointments    Boolean  @default(true)
  autoStartInPersonAppointments  Boolean  @default(true)
  requirePatientNotice           Boolean  @default(true)
  requireInPersonConfirmation    Boolean  @default(true)
  saveTranscriptByDefault        Boolean  @default(true)
  attachToMedicalRecordByDefault Boolean  @default(false)
  provider                       String   @default("speaches")
  model                          String   @default("deepdml/faster-whisper-large-v3-turbo-ct2")
  fallbackModel                  String   @default("Systran/faster-whisper-small")
  language                       String   @default("pt")
  sampleRate                     Int      @default(16000)
  chunkMs                        Int      @default(1000)
  saveAudio                      Boolean  @default(false)
  maxSessionMinutes              Int?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  tenant Nutritionist @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("transcription_settings")
}

model AppointmentTranscript {
  id                String           @id @default(cuid())
  tenantId          String
  appointmentId     String?
  careSessionId     String?
  patientId         String
  status            TranscriptStatus @default(LIVE)
  provider          String
  model             String?
  language          String           @default("pt")
  sampleRate        Int?
  chunkMs           Int?
  autoStarted       Boolean          @default(false)
  onlineMode        Boolean          @default(false)
  inPersonMode      Boolean          @default(false)
  saveAudio         Boolean          @default(false)
  noticeConfirmedAt DateTime?
  startedAt         DateTime?
  pausedAt          DateTime?
  endedAt           DateTime?
  savedAt           DateTime?
  savedByUserId     String?
  discardedAt       DateTime?
  attachedNoteId    String?
  segmentCount      Int              @default(0)
  durationSeconds   Int?
  providerLatencyMs Int?
  errorCount        Int              @default(0)
  lastErrorCode     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant       Nutritionist                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment  Appointment?                       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  careSession  CareSession?                       @relation(fields: [careSessionId], references: [id], onDelete: SetNull)
  patient      Patient                            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  savedBy      User?                              @relation("TranscriptSavedBy", fields: [savedByUserId], references: [id], onDelete: SetNull)
  segments     AppointmentTranscriptSegment[]
  participants AppointmentTranscriptParticipant[]

  @@index([tenantId, appointmentId])
  @@index([tenantId, careSessionId])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, status])
  @@map("appointment_transcripts")
}

model AppointmentTranscriptSegment {
  id                  String                  @id @default(cuid())
  tenantId            String
  transcriptId        String
  appointmentId       String?
  careSessionId       String?
  segmentKey          String
  participantId       String?
  speakerUserId       String?
  speakerPatientId    String?
  speakerNameSnapshot String?
  speakerRoleSnapshot String?
  source              TranscriptSpeakerSource @default(UNKNOWN)
  text                String
  isFinal             Boolean                 @default(true)
  confidence          Float?
  startedAtMs         Int?
  endedAtMs           Int?
  clientTimestamp     DateTime?
  providerTimestamp   DateTime?
  createdAt           DateTime                @default(now())

  transcript AppointmentTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, segmentKey])
  @@index([tenantId, transcriptId, createdAt])
  @@index([tenantId, appointmentId, createdAt])
  @@index([tenantId, careSessionId, createdAt])
  @@index([tenantId, source, createdAt])
  @@map("appointment_transcript_segments")
}

model AppointmentTranscriptParticipant {
  id                   String                  @id @default(cuid())
  tenantId             String
  transcriptId         String
  participantId        String
  speakerUserId        String?
  speakerPatientId     String?
  speakerNameSnapshot  String?
  source               TranscriptSpeakerSource @default(UNKNOWN)
  noticeAcknowledgedAt DateTime?
  consentDeclinedAt    DateTime?
  audioState           String                  @default("idle")
  lastSeenAt           DateTime                @default(now())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  transcript AppointmentTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, participantId])
  @@index([tenantId, transcriptId])
  @@map("appointment_transcript_participants")
}

model TranscriptionUsageCounter {
  id                 String   @id @default(cuid())
  tenantId           String
  yearMonth          String
  provider           String
  model              String   @default("")
  sessionsStarted    Int      @default(0)
  sessionsCompleted  Int      @default(0)
  sessionsFailed     Int      @default(0)
  minutesTranscribed Int      @default(0)
  segmentsCreated    Int      @default(0)
  providerErrors     Int      @default(0)
  latencyTotalMs     Int      @default(0)
  latencySamples     Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Nutritionist @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, yearMonth, provider, model])
  @@index([tenantId, yearMonth])
  @@map("transcription_usage_counters")
}

// ─── Sprint Governança: RBAC Granular, Auditoria, Sessões, LGPD, Admin ───────

enum PermissionEffect {
  ALLOW
  DENY
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "patients.view", "anamnesis.edit"
  resource    String // e.g. "patients", "anamnesis"
  action      String // e.g. "view", "create", "edit", "delete"
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  overrides       MemberPermissionOverride[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String         @id @default(cuid())
  tenantId     String? // se nulo, é padrão do sistema para aquela role
  role         TeamMemberRole
  permissionId String
  enabled      Boolean        @default(true)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model MemberPermissionOverride {
  id           String           @id @default(cuid())
  teamMemberId String
  permissionId String
  effect       PermissionEffect
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, permissionId])
  @@index([teamMemberId])
  @@map("member_permission_overrides")
}

model AuditLog {
  id                    String      @id @default(cuid())
  tenantId              String
  actorUserId           String
  actorTeamMemberId     String?
  actorNameSnapshot     String
  actorRoleSnapshot     String
  action                String // e.g. "patient.view", "anamnesis.update"
  resource              String // e.g. "patient", "anamnesis"
  resourceId            String
  resourceLabelSnapshot String?
  patientId             String?
  patientNameSnapshot   String?
  appointmentId         String?
  result                AuditResult @default(SUCCESS)
  reason                String?
  changedFields         String[]
  metadata              Json?
  ipHash                String?
  userAgent             String?
  sessionId             String?
  createdAt             DateTime    @default(now())

  nutritionist Nutritionist @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser    User         @relation("ActorUser", fields: [actorUserId], references: [id], onDelete: Cascade)
  actorMember  TeamMember?  @relation("ActorTeamMember", fields: [actorTeamMemberId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([patientId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model UserSession {
  id               String        @id @default(cuid())
  userId           String
  tenantId         String?
  sessionTokenHash String        @unique
  status           SessionStatus @default(ACTIVE)
  ipHash           String?
  ipCountry        String?
  ipRegion         String?
  userAgent        String?
  deviceType       String?
  browser          String?
  os               String?
  lastSeenAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tenantId, status])
  @@index([lastSeenAt])
  @@map("user_sessions")
}

model ConsentRecord {
  id              String        @id @default(cuid())
  tenantId        String
  patientId       String
  consentType     String // e.g. "HEALTH_DATA", "EMAIL_COMMUNICATION"
  status          ConsentStatus @default(GRANTED)
  version         String        @default("v1.0")
  textSnapshot    String
  source          String // e.g. "PUBLIC_FORM", "PATIENT_PORTAL", "MANUAL"
  grantedAt       DateTime      @default(now())
  revokedAt       DateTime?
  createdByUserId String?
  metadata        Json?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, grantedAt])
  @@index([patientId, status])
  @@map("consent_records")
}

model DataSubjectRequest {
  id              String    @id @default(cuid())
  tenantId        String
  patientId       String
  type            String // e.g. "ACCESS", "EXPORT", "DELETION"
  status          String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  requestedAt     DateTime  @default(now())
  completedAt     DateTime?
  handledByUserId String?
  notes           String?
  auditLogId      String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([patientId])
  @@map("data_subject_requests")
}

model SecurityEvent {
  id                String    @id @default(cuid())
  tenantId          String?
  severity          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  type              String // e.g. "MULTIPLE_FAILED_LOGINS", "PERMISSION_DENIED_SPIKE"
  title             String
  description       String
  relatedAuditLogId String?
  actorUserId       String?
  status            String    @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([tenantId, severity, status])
  @@index([status, createdAt])
  @@map("security_events")
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  code           String   @unique // e.g. "FREE", "BASIC", "PRO", "CLINIC"
  name           String
  description    String?
  priceCents     Int      @default(0)
  maxPatients    Int?
  maxTeamMembers Int?
  features       Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions TenantSubscription[]
  featureLimits FeatureLimit[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id                 String        @id @default(cuid())
  tenantId           String        @unique
  planId             String
  status             BillingStatus @default(TRIAL)
  trialStartedAt     DateTime      @default(now())
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  nutritionist Nutritionist     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("tenant_subscriptions")
}

/// Per-plan usage limits and feature flags, keyed by a free-form feature key
/// (e.g. "patients.max", "team.max", "pdf.monthly", "auditTrail.enabled").
/// `limit` = null means unlimited; for boolean feature flags, `enabled` is
/// the source of truth and `limit` is left null.
model FeatureLimit {
  id        String   @id @default(cuid())
  planId    String
  key       String
  limit     Int?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("feature_limits")
}

/// Rolling usage counters per tenant per feature key per counting window
/// (e.g. one row per tenant+"pdf.monthly"+first-day-of-month). Matched
/// against `FeatureLimit.limit` for the tenant's current plan to enforce caps.
model UsageCounter {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  periodStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  nutritionist Nutritionist @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, periodStart])
  @@index([tenantId, key])
  @@map("usage_counters")
}

/// One row per uploaded file, across every upload flow in the app (documents,
/// templates, profile photos, transcription audio, generic editor uploads).
/// This is the single source of truth for "how much storage does this tenant
/// use" — computed on demand via SUM(sizeBytes), never a drifting counter.
model StorageFile {
  id               String   @id @default(cuid())
  tenantId         String
  uploadedByUserId String?
  url              String
  sizeBytes        Int
  purpose          String // e.g. "patient-document", "meal-template-file", "nutritionist-profile-photo", "transcription-audio", "general"
  resourceId       String?
  createdAt        DateTime @default(now())

  nutritionist Nutritionist @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, purpose])
  @@index([tenantId, uploadedByUserId])
  @@map("storage_files")
}

/// One row per tenant per day (UTC), written by the daily storage snapshot
/// cron (`/api/cron/storage-snapshot`). Exists because `StorageFile` only
/// tells you the CURRENT total — growth-over-time, "days until quota" and
/// admin history charts need a persisted rollup instead of re-scanning the
/// full ledger for every historical point. `snapshotDate` + unique(tenantId,
/// snapshotDate) makes the daily write idempotent (Vercel Cron delivery can
/// invoke the same scheduled run more than once — see Vercel Cron Jobs docs).
model StorageUsageSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  snapshotDate DateTime
  /// BigInt, not Int: a single tenant's total (or the CLINIC plan's 20GB
  /// quota) in bytes already exceeds the ~2.1B ceiling of a 32-bit INTEGER —
  /// confirmed by a real overflow error while testing this migration.
  totalBytes   BigInt
  totalFiles   Int
  quotaBytes   BigInt?
  usedPercent  Int?
  createdAt    DateTime @default(now())

  nutritionist Nutritionist                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  byPurpose    StorageUsageByPurposeSnapshot[]

  @@unique([tenantId, snapshotDate])
  @@index([tenantId, snapshotDate])
  @@map("storage_usage_snapshots")
}

/// Per-purpose breakdown attached to a `StorageUsageSnapshot` row, so history
/// charts can show "how did the transcription-audio share grow over time"
/// without re-deriving it from `StorageFile` for past dates.
model StorageUsageByPurposeSnapshot {
  id         String @id @default(cuid())
  snapshotId String
  tenantId   String
  purpose    String
  sizeBytes  BigInt
  fileCount  Int

  snapshot StorageUsageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, purpose])
  @@index([tenantId, purpose, snapshotId])
  @@map("storage_usage_by_purpose_snapshots")
}

/// Per-tenant override of a plan's FeatureLimit, used for manual exceptions
/// (promotions, temporary bumps, negotiated deals) without creating a new
/// plan. When present and not expired, it wins over the plan's own limit —
/// see `getTenantSubscriptionContext()` in src/lib/billing/subscription-context.ts.
model TenantFeatureOverride {
  id              String    @id @default(cuid())
  tenantId        String
  key             String
  limit           Int?
  enabled         Boolean   @default(true)
  reason          String?
  expiresAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  nutritionist Nutritionist @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_feature_overrides")
}

/// Audit trail for platform-level Global Admin actions that are NOT scoped to
/// a single tenant (e.g. editing a plan's catalog limits) — `AuditLog.tenantId`
/// has a required FK to `Nutritionist`, so it cannot represent "this changed
/// the PRO plan for everyone." This table intentionally has no tenant FK.
model GlobalAuditLog {
  id                    String      @id @default(cuid())
  actorUserId           String
  actorNameSnapshot     String
  actorRoleSnapshot     String
  action                String
  resource              String
  resourceId            String
  resourceLabelSnapshot String?
  result                AuditResult @default(SUCCESS)
  reason                String?
  changedFields         String[]
  metadata              Json?
  createdAt             DateTime    @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@map("global_audit_logs")
}
