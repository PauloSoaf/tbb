# Select exactly one runtime: cpu or gpu.
COMPOSE_PROJECT_NAME=""
COMPOSE_PROFILES=""
NODE_ENV=""

# NutriOpus-facing configuration. The browser connects only to the gateway.
TRANSCRIPTION_ENABLED=""
TRANSCRIPTION_PROVIDER=""
TRANSCRIPTION_WS_URL=""
TRANSCRIPTION_HTTP_URL=""
TRANSCRIPTION_DEFAULT_MODEL=""
TRANSCRIPTION_FALLBACK_MODEL=""
TRANSCRIPTION_ALLOWED_MODELS=""
TRANSCRIPTION_LANGUAGE=""
TRANSCRIPTION_SAMPLE_RATE=""
TRANSCRIPTION_CHUNK_MS=""
TRANSCRIPTION_SAVE_AUDIO=""
TRANSCRIPTION_AUTO_START_ONLINE=""
TRANSCRIPTION_AUTO_START_IN_PERSON=""
TRANSCRIPTION_MAX_RECONNECT_ATTEMPTS=""
TRANSCRIPTION_PROVIDER_HEALTHCHECK_INTERVAL_SECONDS=""

# Generate both values independently. Never expose either one to browser code.
# Example: openssl rand -base64 48
TRANSCRIPTION_GATEWAY_HMAC_SECRET=""
SPEACHES_API_KEY=""

# Gateway ingress. Keep loopback in local development; use 0.0.0.0 only behind TLS.
GATEWAY_BIND_ADDRESS=""
GATEWAY_PUBLIC_PORT=""
GATEWAY_ALLOWED_ORIGINS=""
GATEWAY_REQUIRE_ORIGIN=""
GATEWAY_ALLOW_QUERY_TOKEN=""
GATEWAY_TRUST_PROXY=""
GATEWAY_TOKEN_ISSUER=""
GATEWAY_TOKEN_AUDIENCE=""
GATEWAY_TOKEN_MAX_TTL_SECONDS=""
GATEWAY_TOKEN_CLOCK_SKEW_SECONDS=""
GATEWAY_TOKEN_SINGLE_USE=""
GATEWAY_MAX_CONNECTIONS_PER_IP=""
GATEWAY_MAX_MESSAGE_BYTES=""
GATEWAY_MAX_AUDIO_CHUNK_BYTES=""
GATEWAY_MAX_MESSAGES_PER_SECOND=""
GATEWAY_MAX_BYTES_PER_SECOND=""
GATEWAY_MAX_PENDING_BYTES=""
GATEWAY_IDLE_TIMEOUT_SECONDS=""
GATEWAY_MAX_SESSION_SECONDS=""
GATEWAY_HEARTBEAT_INTERVAL_SECONDS=""
GATEWAY_UPSTREAM_CONNECT_TIMEOUT_MS=""
GATEWAY_LOG_LEVEL=""

# Optional protection for /metrics. Set a random value in production.
GATEWAY_METRICS_BEARER_TOKEN=""

# Speaches 0.9.0-rc.3 images verified in GHCR. Pin by digest in strict production.
SPEACHES_CPU_IMAGE=""
SPEACHES_GPU_IMAGE=""
SPEACHES_FASTAPI_VERSION=""
SPEACHES_PRELOAD_MODELS=""
SPEACHES_STT_MODEL_TTL_SECONDS=""
SPEACHES_HEALTH_START_PERIOD=""
SPEACHES_LOG_LEVEL=""
SPEACHES_ENABLE_UI=""
SPEACHES_ALLOW_ORIGINS=""
SPEACHES_MODEL_CACHE_VOLUME=""

# CPU defaults. int8 reduces memory use; 0 lets CTranslate2 choose thread count.
SPEACHES_CPU_COMPUTE_TYPE=""
SPEACHES_CPU_THREADS=""
SPEACHES_CPU_WORKERS=""

# NVIDIA GPU defaults.
SPEACHES_GPU_COMPUTE_TYPE=""
SPEACHES_GPU_DEVICE_INDEX=""
SPEACHES_GPU_WORKERS=""

# Optional Hugging Face access/rate-limit token and Speaches OTLP export.
HF_TOKEN=""
SPEACHES_OTEL_ENDPOINT=""
SPEACHES_OTEL_SERVICE_NAME=""
